<script>
    document.addEventListener("DOMContentLoaded", function() {
        const elements = [
            "header_office_select",
            "office_select",
            "footer_office_select",
            "current-location",
            "footer-current-location"
        ];

        elements.forEach(function(id) {
            const element = document.getElementById(id);
            if (element) {
                element.addEventListener("change", function() {
                    window.location.href = this.value;
                });
            }
        });
    });

    function setCookie(key, value) {
        var expiryTime = new Date();
        expiryTime.setTime(expiryTime.getTime() + 1 * 60 * 1000); // save cookie for 1 minute
        document.cookie = key + "=" + JSON.stringify(value) + "; expires=" + expiryTime.toUTCString() + "; path=/";
    }

    function submitHidden(path, params, method) {
        method = method || "post";

        var form = document.createElement("form");
        form.setAttribute("method", method);
        form.setAttribute("action", path);

        for (var key in params) {
            if (params.hasOwnProperty(key)) {
                if (params[key] != "") {
                    if (Array.isArray(params[key])) {
                        params[key].forEach(function(value, index) {
                            var hiddenField = document.createElement("input");
                            hiddenField.setAttribute("type", "hidden");
                            hiddenField.setAttribute("name", key + "[]");
                            hiddenField.setAttribute("value", value);
                            form.appendChild(hiddenField);
                        });
                    } else {
                        var hiddenField = document.createElement("input");
                        hiddenField.setAttribute("type", "hidden");
                        hiddenField.setAttribute("name", key);
                        hiddenField.setAttribute("value", params[key]);
                        form.appendChild(hiddenField);
                    }
                }
            }
        }

        document.body.appendChild(form);
        form.submit();
    }

    function confirmAndReload() {
        alert("Session expired! Please refresh the page and try again.");
        location.reload();
    }

    function changeFavorite(chk) {
        $(chk).prop('disabled', true);
        var params = {
            ids: [{
                'stock_id': chk.value,
                'car_id': chk.getAttribute('data-car-id')
            }]
        };
        if (chk.checked) {
            params['type'] = 1;
            window.dataLayer = window.dataLayer || [];
            dataLayer.push({
                event: 'add_to_favorites',
                stock_id: chk.value
            });
        } else {
            params['type'] = 3;
            window.dataLayer = window.dataLayer || [];
            dataLayer.push({
                event: 'remove_from_favorites',
                stock_id: chk.value
            });

            let rawCookie = getArrayCookie('checked_ids');
            let checkedIds = rawCookie ? JSON.parse(rawCookie) : [];
            checkedIds = checkedIds.filter(ids => ids.stock_id !== chk.value);
            setArrayCookie('checked_ids', JSON.stringify(checkedIds), 1);
        }

        $.ajax({
            url: '/change/favorite',
            type: 'POST',
            headers: {
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            data: params,
            dataType: 'json',
            success: function (data) {
                $(chk).prop('disabled', false);
            },
            error: function (xhr, status, error) {
            }
        });
    }

    function getArrayCookie(name) {
        const nameEQ = name + "=";
        const ca = document.cookie.split(';');
        for (let c of ca) {
            c = c.trim();
            if (c.indexOf(nameEQ) === 0) {
                return decodeURIComponent(c.substring(nameEQ.length));
            }
        }
        return null;
    }

    function setArrayCookie(name, value, days) {
        let expires = "";
        if (days) {
            const date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + encodeURIComponent(value) + expires + "; path=/";
    }
</script>

<script>

    const isEEA = false;

    if (isEEA) {
        function consentGrantedAdStorage() { 
            gtag('consent', 'update', { 
            'ad_storage': 'granted',
            'ad_user_data': 'granted',
            'ad_personalization': 'granted',
            'analytics_storage': 'granted',
            'functionality_storage': 'granted',
            'personalization_storage': 'granted',
            'security_storage': 'granted' 
            }); 

            const expireDateGMT = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toUTCString();
            document.cookie = "cookie_EEAconsent=1; path=/; expires=" + expireDateGMT;
        }

        document.getElementById('cookie-accept').addEventListener('click', consentGrantedAdStorage);
    }

    $(document).on('click', '#cookie-decline', function () {
        dac();
        blockCookies();
    });
    function dac() {
        const cookies = document.cookie.split(';');
        cookies.forEach(cookie => {
            const cookieName = cookie.split('=')[0].trim();
            if (cookieName !== 'cookieConsent') {
                document.cookie = `${cookieName}=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT; SameSite=Strict;`;
            }
        });
    }

    function blockCookies() {
        const originalSetCookie = document.__defineSetter__('cookie', function(value) {
            if (localStorage.getItem('MS_COOKIE_CONSENT') !== 'declined') {
                document.__defineGetter__('cookie', function() {
                    return value;
                });
            }
        });
    }

    // Check if cookies should be blocked on page load
    if (localStorage.getItem('MS_COOKIE_CONSENT') !== 'accepted') {
        dac();
    }

</script>


